{
  "name": "mcsr-tracker",
  "version": "1.0.0",
  "homepage": "https://github.com/chengggit/MCSR-Tracker#readme",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chart.js": "^2.9.41",
    "browser-sync": "^3.0.4",
    "chart.js": "^4.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "scripts": {
    "lint": "eslint src/mcsr/static",
    "lint-fix": "eslint src/mcsr/static --fix",
    "format": "prettier --write src/mcsr/static",
    "format-check": "prettier --check src/mcsr/static",
    "dev-frontend": "browser-sync start --proxy localhost:8000 --files \"src/mcsr/static/**/*\" --port 5500 --no-notify"
  }
}
